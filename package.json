{
  "name": "app-root",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently -k -n \"BACKEND,FRONTEND,OPENWA\" -c \"blue,green,magenta\" \"npm run start:backend\" \"npm run start:frontend\" \"npm run start:openwa\"",
    "start:backend": "cd backend && python -m uvicorn server:app --host 0.0.0.0 --port 8000 --reload",
    "start:frontend": "cd frontend && npm start",
    "start:openwa": "cd waha && npm run start:prod"
  },
  "devDependencies": {
    "@craco/craco": "7.1.0",
    "concurrently": "^8.2.2",
    "react-snap": "^1.23.0",
    "sitemap": "^9.0.1"
  }
}
