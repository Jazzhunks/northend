{
  "name": "northend-monorepo",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && uvicorn server:app --reload --port 8001",
    "start:frontend": "cd frontend && npm start",
    "dev": "npm run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
